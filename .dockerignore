# ── Secrets ───────────────────────────────────────────────
# Never bake credentials into the image — passed via env_file at runtime.
.env

# ── Version control ───────────────────────────────────────
.git
.gitignore
.gitattributes

# ── Python artefacts ──────────────────────────────────────
__pycache__
*.pyc
*.pyo
*.pyd
*.pdb

# ── Virtual environments ──────────────────────────────────
.venv
venv
env
ENV

# ── Runtime data (stored in named Docker volumes, not the image) ──
chroma_db/

# ── Model cache (baked into the backend image during build) ──
# Exclude any local .cache dir so it doesn't override the image-level cache.
.cache/

# ── IDE / editor ──────────────────────────────────────────
.vscode/
.idea/
*.code-workspace

# ── OS artefacts ──────────────────────────────────────────
.DS_Store
Thumbs.db
