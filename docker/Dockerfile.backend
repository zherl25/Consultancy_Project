# ════════════════════════════════════════════════════════════
#  Consultant AI — Backend (FastAPI / RAG API)
#  Build context: project root  (set in docker-compose.yml)
# ════════════════════════════════════════════════════════════

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# ── Python dependencies ───────────────────────────────────
# Copied first so this layer is cached unless requirements change.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ── Embedding model pre-download ──────────────────────────
# Bakes the model into the image so the container never phones home at runtime.
# HF_HUB_OFFLINE must NOT be set at this stage so the download can proceed.
ENV SENTENCE_TRANSFORMERS_HOME=/app/.cache/models
RUN python -c "\
from sentence_transformers import SentenceTransformer; \
SentenceTransformer('all-MiniLM-L6-v2'); \
print('Embedding model cached.')"

# ── Application source ────────────────────────────────────
# Placed after the model layer: code changes don't bust the slow layers above.
COPY . .

# ── Runtime environment ───────────────────────────────────
ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    # nginx serves the frontend in Docker; FastAPI is API-only
    SERVE_STATIC=false

EXPOSE 8000

# ── Health check ──────────────────────────────────────────
# start_period gives the model time to initialise on first boot.
HEALTHCHECK \
  --interval=30s \
  --timeout=10s \
  --start-period=90s \
  --retries=3 \
  CMD python -c "\
import urllib.request, sys; \
urllib.request.urlopen('http://localhost:8000/health'); \
sys.exit(0)" || exit 1

CMD ["python", "-m", "uvicorn", "app.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "1"]
